      "tr": ["dayanıklılık", "iç güç", "sessiz mücadele"],
      "fr": ["résilience", "force intérieure", "lutte silencieuse"],
      "pt": ["resiliência", "força interior", "luta silenciosa"],
      "nl": ["veerkracht", "innerlijke kracht", "stille strijd"],
      "es": ["resiliencia", "fuerza interior", "lucha silenciosa"],
