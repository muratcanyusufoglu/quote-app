      "category": "courage",
      "tags": {
        "en": ["resilience", "perseverance", "failure"],
        "tr": ["dayanıklılık", "azim", "başarısızlık"],
        "fr": ["résilience", "persévérance", "échec"],
        "pt": ["resiliência", "perseverança", "fracasso"],
        "nl": ["veerkracht", "doorzettingsvermogen", "mislukking"],
        "es": ["resiliencia", "perseverancia", "fracaso"],
        "de": ["Widerstandsfähigkeit", "Ausdauer", "Scheitern"],
