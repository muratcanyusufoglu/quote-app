      "ru": ["стойкость", "внутренняя сила", "тихая борьба"],
      "id": ["ketahanan", "kekuatan batin", "perjuangan sunyi"],
      "ja": ["回復力", "内なる強さ", "静かな闘争"],
      "th": ["ความยืดหยุ่น", "พลังภายใน", "การต่อสู้อย่างเงียบๆ"],
